# Airport mapping
MAX_AIRPORT_DISTANCE_KM=50

# Airline enrichment
INCLUDE_AIRLINE=false

# SQLite pipeline
SQLITE_PATH=flights_adsb.sqlite

# History / retention
MINUTE_HISTORY_LIMIT=1440
RETENTION_DAYS=0

# Default airport filter for dashboard (ICAO, e.g., VABB for BOM)
DEFAULT_AIRPORT=

# Limit how many flights are stored in snapshot.json/latest.json
MAX_SNAPSHOT_ROWS=500
